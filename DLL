steps:
  - name: Checkout repo
    uses: actions/checkout@v4

  - name: Setup .NET
    uses: actions/setup-dotnet@v4
    with:
      dotnet-version: '8.0.x'

  - name: Validate required DLLs
    shell: pwsh
    run: |
      $required = @(
        'libs/StardewValley.dll',
        'libs/StardewModdingAPI.dll',
        'libs/xTile.dll'
      )

      foreach ($path in $required) {
        if (-not (Test-Path $path)) {
          throw "Missing required dependency: $path"
        }
      }

  - name: Restore packages
    run: dotnet restore VirtualKeyBlue.csproj

  - name: Build mod
    run: dotnet build VirtualKeyBlue.csproj -c Release --no-restore

  - name: Package ZIP
    shell: pwsh
    run: |
      $buildDir = "bin/Release/net8.0"
      $artifactDir = "release"
      New-Item -ItemType Directory -Force -Path $artifactDir | Out-Null

      Copy-Item "manifest.json" "$artifactDir/manifest.json"
      Copy-Item "config.json" "$artifactDir/config.json"
      Copy-Item "README.md" "$artifactDir/README.md"
      if (Test-Path "assets") { Copy-Item "assets" "$artifactDir/assets" -Recurse -Force }
      Copy-Item "$buildDir/VirtualKeyBlue.dll" "$artifactDir/VirtualKeyBlue.dll"

      Compress-Archive -Path "$artifactDir/*" -DestinationPath "VirtualKeyBlue.zip" -Force

  - name: Upload build artifact
    uses: actions/upload-artifact@v4
    with:
      name: VirtualKeyBlue
      path: VirtualKeyBlue.zip
